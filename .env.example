# Kopiera till .env och fyll i. .env committas aldrig.

# Postgres — samma värde i ConnectionStrings nedan
POSTGRES_PASSWORD=gymprogress

# Lokal `dotnet run` mot docker-compose.dev.yml (host-port 5433)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=gymprogress;Username=gymprogress;Password=gymprogress

# JWT — minst 32 tecken. Byt till en egen slumpad sträng innan du exponerar appen.
JWT_KEY=byt-ut-denna-till-minst-32-slumpade-tecken!

# Komma-separerade originer som får anropa API:t.
# Docker-stacken (nginx på WEB_PORT) proxar /api, så samma origin räcker.
# Lägg till din Tailscale-adress, t.ex. http://din-dator.tailnet.ts.net
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:4200

# Host-port för webbappen i docker compose (nginx). API:t proxas via /api.
WEB_PORT=80

# LM Studio (valfritt). Tom Model använder den modell som är laddad.
# Lokal `dotnet run`: http://localhost:1234
# docker compose pekar automatiskt på http://host.docker.internal:1234
AI_BASE_URL=http://localhost:1234
AI_MODEL=
